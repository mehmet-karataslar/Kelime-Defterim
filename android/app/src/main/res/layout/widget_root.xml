<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_desc" />

    <LinearLayout
        android:id="@+id/w_quiz_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/w_btn_der"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:scaleType="fitXY"
            android:contentDescription="der" />

        <ImageView
            android:id="@+id/w_btn_die"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:scaleType="fitXY"
            android:contentDescription="die" />

        <ImageView
            android:id="@+id/w_btn_das"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:scaleType="fitXY"
            android:contentDescription="das" />
    </LinearLayout>
</LinearLayout>