<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="18dp">

    <TextView
        android:id="@+id/init_article"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="die"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#E11D48"
        android:background="@drawable/widget_chip_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />

    <TextView
        android:id="@+id/init_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Möglichkeit"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1E1B2E"
        android:layout_marginTop="5dp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/init_meaning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="İmkân, olasılık"
        android:textSize="15sp"
        android:textColor="#64748B"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
